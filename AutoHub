	-- دالة Tween مخصصة وسلسة للشخصية
	local function customTween(targetPos, speed)
		local character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		local rootPart = character.HumanoidRootPart
	
		speed = speed or 250
	
		local connection
		connection = RunService.RenderStepped:Connect(function(dt)
			if not character or not character.Parent or not rootPart.Parent then
				connection:Disconnect()
				return
			end
	
			local currentPos = rootPart.Position
			local distance = (targetPos - currentPos).Magnitude
	
			if distance < 5 then
				rootPart.CFrame = CFrame.new(targetPos)
				connection:Disconnect()
			else
				local direction = (targetPos - currentPos).Unit
				rootPart.CFrame = CFrame.new(currentPos + direction * math.min(speed * dt, distance))
				rootPart.Velocity = Vector3.new(0, 0, 0)
			end
		end)
	
		repeat task.wait() until not connection.Connected
	end
	
	-- التحقق مما إذا كان اللاعب لديه مهمة نشطة حالياً
	local function hasActiveQuest()
		local questGui = player.PlayerGui:FindFirstChild("QuestGui") 
		if questGui and questGui.Enabled then
			return true
		end
	
		local dataFolder = player:FindFirstChild("Data")
		if dataFolder and dataFolder:FindFirstChild("InQuest") and dataFolder.InQuest.Value == true then
			return true
		end
		return false
	end
	
	-- البحث عن العدو المطلوب في العالم
	local function findTargetEnemy(enemyName)
		local enemiesFolder = Workspace:FindFirstChild("Enemies") or Workspace
		for _, obj in ipairs(enemiesFolder:GetChildren()) do
			if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and obj.Humanoid.Health > 0 then
				if obj.Name == enemyName or string.find(obj.Name, enemyName) then
					return obj
				end
			end
		end
		return nil
	end
	
	-- إمساك الأداة تلقائياً بناءً على الـ Attribute المختار
	local function equipSelectedTool()
		local character = player.Character
		if not character then return end
	
		local currentType = player:GetAttribute("AutoType") or "Melee"
		local foundTool = nil
	
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") then
				foundTool = tool
				break
			end
		end
	
		if not foundTool then
			for _, tool in ipairs(backpack:GetChildren()) do
				if tool:IsA("Tool") then
					if currentType == "Melee" and (tool.Name:lower():find("fist") or tool.Name:lower():find("combat") or tool.Name:lower():find("leg") or tool.Name:lower():find("melee") or tool:FindFirstChild("Level")) then
						foundTool = tool
						break
					elseif currentType == "Demon Fruit" and (tool.Name:lower():find("fruit") or tool.Name:lower():find("flame") or tool.Name:lower():find("ice") or tool.Name:lower():find("magma") or tool.Name:lower():find("light")) then
						foundTool = tool
						break
					elseif currentType == "Sword" and tool.Name:lower():find("sword") then
						foundTool = tool
						break
					end
				end
			end
		end
	
		if not foundTool and #backpack:GetChildren() > 0 then
			for _, tool in ipairs(backpack:GetChildren()) do
				if tool:IsA("Tool") then
					foundTool = tool
					break
				end
			end
		end
	
		if foundTool and foundTool.Parent == backpack then
			foundTool.Parent = character
		end
	end
	
	-- إفلات الأداة عند إيقاف الفارم
	local function unequipAllTools()
		local character = player.Character
		if not character then return end
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") then
				tool.Parent = backpack
			end
		end
	end
	
	local isRunning = false
	
	mainButton.MouseButton1Click:Connect(function()
		isRunning = not isRunning
	
		if not isRunning then
			print("تم إيقاف الأوتو فارم.")
			unequipAllTools()
			return
		end
	
		print("تم تفعيل الأوتو فارم حتى المستوى 2800 (تحديثات 2026)!")
	
		task.spawn(function()
			while isRunning do
				task.wait(0.5)
	
				equipSelectedTool()
	
				local dataFolder = player:FindFirstChild("Data")
				if not dataFolder or not dataFolder:FindFirstChild("Level") then continue end
	
				local currentLevel = dataFolder.Level.Value
	
				-- تحديد المهمة المناسبة لمستوى اللاعب الحالي
				local currentQuestData = nil
				for _, data in ipairs(questsData) do
					if currentLevel >= data.minLevel and currentLevel <= data.maxLevel then
						currentQuestData = data
						break
					end
				end
				if not currentQuestData then currentQuestData = questsData[#questsData] end
	
				-- الخطوة 1: إذا لم تكن هناك مهمة نشطة، اذهب إلى الـ NPC وخذها عبر ريموت QuestUpdate
				if not hasActiveQuest() then
					print("الذهاب إلى الـ NPC لأخذ المهمة...")
					customTween(currentQuestData.npcPos, 300)
					task.wait(0.5)
	
					remoteEvent:FireServer("StartQuest", currentQuestData.questName)
					remoteEvent:FireServer(currentQuestData.questName)
					task.wait(1.5)
				else
					-- الخطوة 2: البحث عن العدو المستهدف
					local enemy = findTargetEnemy(currentQuestData.enemy)
	
					if enemy then
						local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
						local enemyHumanoid = enemy:FindFirstChild("Humanoid")
	
						if enemyRoot and enemyHumanoid then
							-- توسيع حجم الـ Hitbox للعدو لتستطيع ضربه وأنت فوقه بسهولة
							enemyRoot.Size = Vector3.new(20, 20, 20)
							enemyRoot.Transparency = 0.9
							enemyRoot.CanCollide = false
	
							-- الانتقال بحركة دائرية تشبه النجمة فوق العدو
							local angle = tick() * 12
							local hoverPos = enemyRoot.Position + Vector3.new(math.sin(angle) * 7, 12, math.cos(angle) * 7)
	
							local character = player.Character
							if character and character:FindFirstChild("HumanoidRootPart") then
								character.HumanoidRootPart.CFrame = CFrame.new(hoverPos, enemyRoot.Position)
								character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
							end
						end
					else
						-- الخطوة 3: إذا لم يوجد العدو في مكانه، توجه إلى مكان الترسيب (SpawnPos)
						print("العدو غير موجود، التوجه إلى مكان الترسيب الخاص به...")
						customTween(currentQuestData.spawnPos, 300)
					end
				end
			end
	
			unequipAllTools()
		end)
	end)
end)

