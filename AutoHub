-- تشغيل برمجة: زر التشغيل (ToggleBtn)
task.spawn(function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	
	local backpack = player:WaitForChild("Backpack")
	local mainButton = ui_ToggleBtn_3
	
	local gui = mainButton.Parent
	local meleeBtn = gui:WaitForChild("MeleeBtn")
	local fruitBtn = gui:WaitForChild("FruitBtn")
	local swordBtn = gui:WaitForChild("SwordBtn")
	
	local function updateButtonColors(selectedBtn)
		local buttons = {meleeBtn, fruitBtn, swordBtn}
		for _, btn in ipairs(buttons) do
			if btn == selectedBtn then
				btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			else
				btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			end
		end
	end
	
	player:SetAttribute("AutoType", "Melee")
	updateButtonColors(meleeBtn)
	
	meleeBtn.MouseButton1Click:Connect(function()
		player:SetAttribute("AutoType", "Melee")
		updateButtonColors(meleeBtn)
	end)
	
	fruitBtn.MouseButton1Click:Connect(function()
		player:SetAttribute("AutoType", "Demon Fruit")
		updateButtonColors(fruitBtn)
	end)
	
	swordBtn.MouseButton1Click:Connect(function()
		player:SetAttribute("AutoType", "Sword")
		updateButtonColors(swordBtn)
	end)
	
	local function unequipAllTools()
		local character = player.Character
		if not character then return end
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") then
				tool.Parent = backpack
			end
		end
	end
	
	local isRunning = false
	
	mainButton.MouseButton1Click:Connect(function()
		isRunning = not isRunning
	
		if not isRunning then
			print("تم إيقاف الأوتو فارم.")
			unequipAllTools()
		else
			print("تم تشغيل الأوتو فارم.")
		end
	end)
end)


-- تشغيل برمجة: تحديث الليفل (Level)
task.spawn(function()
	local textLabel = ui_Level_9
	
	local function updateLevelText(levelValue)
		if levelValue then
			textLabel.Text = "Level: " .. tostring(levelValue.Value)
			levelValue.Changed:Connect(function(newValue)
				textLabel.Text = "Level: " .. tostring(newValue)
			end)
		else
			textLabel.Text = "Level: N/A"
		end
	end
	
	local dataFolder = player:FindFirstChild("Data")
	if dataFolder then
		local levelValue = dataFolder:FindFirstChild("Level")
		updateLevelText(levelValue)
	else
		player.ChildAdded:Connect(function(child)
			if child.Name == "Data" then
				local levelValue = child:WaitForChild("Level", 5)
				updateLevelText(levelValue)
			end
		end)
	end
end)


-- تشغيل برمجة: سحب النافذة (Draggable MainFrame)
task.spawn(function()
	local frame = ui_MainFrame_2
	local userInputService = game:GetService("UserInputService")
	
	local dragging = false
	local dragInput, mousePos, framePos
	
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			mousePos = input.Position
			framePos = frame.Position
	
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	
	userInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - mousePos
			frame.Position = UDim2.new(
				framePos.X.Scale,
				framePos.X.Offset + delta.X,
				framePos.Y.Scale,
				framePos.Y.Offset + delta.Y
			)
		end
	end)
end)
