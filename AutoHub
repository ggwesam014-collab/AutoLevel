	-- مسار الريموت إيفينت الصحيح: ReplicatedStorage.Remotes.QuestUpdate
	local remoteEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("QuestUpdate")
	
	local mainButton = script.Parent -- زر التشغيل الرئيسي (Auto Farm Button)
	
	-- مسارات الأزرار الثلاثة
	local gui = mainButton.Parent
	local meleeBtn = gui:WaitForChild("MeleeBtn")
	local fruitBtn = gui:WaitForChild("FruitBtn")
	local swordBtn = gui:WaitForChild("SwordBtn")
	
	-- دالة لتحديث ألوان الأزرار (المختار أخضر والباقي يرجع للون العادي)
	local function updateButtonColors(selectedBtn)
		local buttons = {meleeBtn, fruitBtn, swordBtn}
		for _, btn in ipairs(buttons) do
			if btn == selectedBtn then
				btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- أخضر
			else
				btn.BackgroundColor3 = Color3.fromRGB(33, 33, 33) -- أبيض / افتراضي
			end
		end
	end
	
	-- تعيين القيمة واللون الافتراضي (Melee)
	player:SetAttribute("AutoType", "Melee")
	updateButtonColors(meleeBtn)
	
	-- تفاعل الأزرار
	meleeBtn.MouseButton1Click:Connect(function()
		player:SetAttribute("AutoType", "Melee")
		updateButtonColors(meleeBtn)
		print("تم اختيار النوع: Melee")
	end)
	
	fruitBtn.MouseButton1Click:Connect(function()
		player:SetAttribute("AutoType", "Demon Fruit")
		updateButtonColors(fruitBtn)
		print("تم اختيار النوع: Demon Fruit")
	end)
	
