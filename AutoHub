task.spawn(function()
	local script = setmetatable({Parent = ui_Level_9, Name = "LocalScript"}, {__index = ui_Level_9})
	-- الحصول على اللاعب المحلي (المستخدم الحالي)
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	
	-- الـ TextLabel الذي سيتم عرض النص عليه (هنا افترضنا أن السكربت بداخله)
	local textLabel = script.Parent
	
	-- وظيفة لتحديث النص بناءً على القيمة
	local function updateLevelText(levelValue)
		if levelValue then
			textLabel.Text = "Level: " .. tostring(levelValue.Value)
	
			-- تحديث النص تلقائياً كلما تغيرت القيمة
			levelValue.Changed:Connect(function(newValue)
				textLabel.Text = "Level: " .. tostring(newValue)
			end)
		else
			textLabel.Text = "Level: N/A"
		end
	end
	
	-- البحث عن مجلد Data وقيمة Level داخله
	local dataFolder = player:FindFirstChild("Data")
	if dataFolder then
		local levelValue = dataFolder:FindFirstChild("Level")
		updateLevelText(levelValue)
	else
		-- إذا لم يكن مجلد Data قد تحميله بعد، ننتظر حتى يتم إنشاؤه
		player.ChildAdded:Connect(function(child)
			if child.Name == "Data" then
				local levelValue = child:WaitForChild("Level", 5)
				updateLevelText(levelValue)
			end
		end)
	end
end)

